# App
NODE_ENV=development
PORT=3001
APP_URL=https://your-app.com

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=shopify_ai_copywriter

# Shopify
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_script_tags
SHOPIFY_HOST_NAME=your-app.com

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Plans
FREE_PLAN_REWRITES=5
STARTER_PLAN_REWRITES=100
GROWTH_PLAN_REWRITES=500
PRO_PLAN_REWRITES=99999

# Billing
# In dev — Shopify charges are created as test=true (no real money)
# In prod — set NODE_ENV=production to enable real charges
# Register these webhooks in Shopify Partner Dashboard:
# app/subscriptions/update → https://your-app.com/api/v1/billing/webhooks/subscription-update
# app/uninstalled          → https://your-app.com/api/v1/auth/webhooks/uninstall
