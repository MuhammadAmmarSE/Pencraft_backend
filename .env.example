# Application
NODE_ENV=development
PORT=3001
APP_URL=https://your-app.com
ADMIN_SECRET_KEY=your_strong_admin_key_here

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_NAME=shopify_ai_copywriter

# Shopify App Credentials (from Partner Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_HOST_NAME=your-app.com

# Anthropic / Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# JWT
JWT_SECRET=your_very_strong_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Session (for OAuth CSRF protection)
SESSION_SECRET=your_very_strong_session_secret_min_32_chars

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Plan Limits (rewrites per month)
FREE_PLAN_REWRITES=5
STARTER_PLAN_REWRITES=100
GROWTH_PLAN_REWRITES=500
PRO_PLAN_REWRITES=99999
